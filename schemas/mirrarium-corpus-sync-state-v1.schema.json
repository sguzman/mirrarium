{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mirrarium:corpus:sync-state:v1",
  "title": "Mirrarium corpus sync state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "mirrarium.corpus.sync-state"
    },
    "schema_version": {
      "const": 1
    },
    "records": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
