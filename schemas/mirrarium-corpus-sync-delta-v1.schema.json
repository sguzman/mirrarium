{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mirrarium:corpus:sync-delta:v1",
  "title": "Mirrarium corpus sync delta v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "sync_state_schema_version",
    "conversation_schema_version",
    "producer_corpus_schema_version",
    "record_type",
    "manifest",
    "upserts",
    "deleted_conversation_ids"
  ],
  "properties": {
    "schema": {
      "const": "mirrarium.corpus.sync-delta"
    },
    "schema_version": {
      "const": 1
    },
    "sync_state_schema_version": {
      "const": 1
    },
    "conversation_schema_version": {
      "const": 1
    },
    "producer_corpus_schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "record_type": {
      "const": "sync-delta"
    },
    "manifest": {
      "$ref": "urn:mirrarium:corpus:export-manifest:v1"
    },
    "upserts": {
      "type": "array",
      "items": {
        "$ref": "urn:mirrarium:corpus:conversation:v1"
      }
    },
    "deleted_conversation_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      }
    }
  }
}
